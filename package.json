{
  "name": "parquet-preview-4mac",
  "displayName": "Parquet Preview 4 Mac",
  "publisher": "TheSuperLeo",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leo4ML/parquet-preview-4mac.git"
  },
  "description": "Preview Parquet files in VS Code",
  "version": "0.0.5",
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:parquet.viewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "parquet.viewer",
        "displayName": "Parquet Viewer",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.60.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "parquetjs-lite": "^0.8.7"
  }
}
